{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/starter.spec.mjs && node scripts/run-security-spec.mjs",
    "test:unit": "node --import tsx --test --experimental-test-coverage tests/unit/inspection-capture.test.ts tests/unit/inspection-queue.test.ts",
    "test:integration": "node --import tsx --test tests/integration/offline-persistence.test.ts tests/integration/inspection-store.test.ts",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
